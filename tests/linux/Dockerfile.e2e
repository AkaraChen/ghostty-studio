FROM rust:1.97.1-bullseye AS driver-builder
RUN cargo install tauri-driver --version 2.0.6 --locked

FROM ghostty-studio-appimage-smoke

USER root
ARG GHOSTTY_VERSION=1.3.1
ARG GHOSTTY_SHA256=fde48d2b716afd1978766879bbf1aae30dd305e8ad86a1037a2614a14d82dc28
RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    curl python3 webkit2gtk-driver \
  && curl --fail --location --retry 3 \
    "https://github.com/pkgforge-dev/ghostty-appimage/releases/download/v${GHOSTTY_VERSION}/Ghostty-${GHOSTTY_VERSION}-x86_64.AppImage" \
    --output /tmp/Ghostty.AppImage \
  && echo "${GHOSTTY_SHA256}  /tmp/Ghostty.AppImage" | sha256sum --check --strict - \
  && chmod 0755 /tmp/Ghostty.AppImage \
  && cd /opt \
  && /tmp/Ghostty.AppImage --appimage-extract >/dev/null \
  && mv squashfs-root ghostty.AppDir \
  && rm /tmp/Ghostty.AppImage \
  && rm -rf /var/lib/apt/lists/*

COPY --from=driver-builder /usr/local/cargo/bin/tauri-driver /usr/local/bin/tauri-driver
COPY ghostty-wrapper.sh /usr/local/bin/ghostty
COPY e2e-appimage.sh /usr/local/bin/e2e-appimage
COPY e2e_appimage.py /usr/local/lib/ghostty-studio/e2e_appimage.py
RUN chmod 0755 /usr/local/bin/ghostty /usr/local/bin/e2e-appimage \
  && /usr/local/bin/ghostty --version | grep -F "${GHOSTTY_VERSION}"

USER smoke
ENTRYPOINT ["/usr/local/bin/e2e-appimage"]
