{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Narrow IPC access for the trusted bundled Ghostty Studio UI.",
  "windows": ["main"],
  "local": true,
  "permissions": [
    "allow-probe-environment",
    "allow-load-runtime-schema",
    "allow-inspect-extension-manifest",
    "allow-load-config-graph",
    "allow-open-config",
    "allow-prepare-create-config-confirmation",
    "allow-create-config",
    "allow-stage-changes",
    "allow-prepare-apply-changes-confirmation",
    "allow-apply-changes",
    "allow-list-snapshots",
    "allow-prepare-restore-snapshot-confirmation",
    "allow-restore-snapshot"
  ]
}
